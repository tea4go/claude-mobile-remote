# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
claude-mobile-remote
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# go.mod/go.sum 为本地状态（含本地 replace），基准见 go.mod.base
go.mod
go.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Node / 前端（apps/mobile 及未来原生工程）
node_modules/
dist/
*.local
npm-debug.log*
.DS_Store

# 前端测试与缓存
coverage/

# 环境与密钥
*.pem
*.key

# Capacitor 原生工程（C1）：本机路径、依赖缓存与 Web 同步产物
# webDir 同步副本（cap sync 从 dist 拷入，不得入库）
apps/mobile/ios/App/App/public/
apps/mobile/android/app/src/main/assets/public/
# iOS 本机产物
apps/mobile/ios/App/Pods/
apps/mobile/ios/App/Podfile.lock
apps/mobile/ios/DerivedData/
apps/mobile/ios/**/xcuserdata/
# Android 本机产物（local.properties 包含本机 SDK 绝对路径）
apps/mobile/android/local.properties
apps/mobile/android/.gradle/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/captures/
# Capacitor 每次 cap sync/update 再生成的 gradle 文件（DO NOT EDIT，不入库）
apps/mobile/android/capacitor.settings.gradle
apps/mobile/android/app/capacitor.build.gradle

# 平台签名与描述文件
*.keystore
*.jks
*.p12
*.p8
*.mobileprovision
*.cer

.qoder/

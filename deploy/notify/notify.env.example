# Private: /etc/cmr-notify/notify.env, root:root 0600. Never under /home/share/verfiles.
# Generate a dedicated random token: openssl rand -hex 32
CMR_NOTIFY_TOKEN=REPLACE_ME
CMR_JPUSH_APP_KEY=REPLACE_ME
CMR_JPUSH_MASTER_SECRET=REPLACE_ME
# TestFlight/App Store/Release provisioning = true; development provisioning = false.
# Use separate gateway instances/tokens for simultaneous sandbox and production tests.
CMR_JPUSH_PRODUCTION=true

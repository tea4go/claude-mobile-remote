# HarmonyOS 签名配置示例
# 复制此文件为 .env 并填写实际值

# .p12 密钥库文件路径（绝对路径）
SIGNING_STORE_FILE=D:\MyPhone\PhoneKey\MyPhoneKey.p12

# .cer 证书文件路径（绝对路径）
SIGNING_CERT_PATH=D:\MyPhone\PhoneCER\MyPhoneCSRDebug.cer

# 密钥别名（通常是 key0 或 debugKey）
SIGNING_KEY_ALIAS=key0

# 密钥库密码（至少 32 个字符）
SIGNING_STORE_PASSWORD=your_password_here_at_least_32_chars

# 密钥密码（通常与密钥库密码相同，至少 32 个字符）
SIGNING_KEY_PASSWORD=your_password_here_at_least_32_chars

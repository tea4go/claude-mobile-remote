{
  "name": "mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "sync:native": "npm run build && cap sync",
    "dev:emu": "vite --host 0.0.0.0",
    "emu:list": "$ANDROID_HOME/emulator/emulator -list-avds",
    "emu:start": "$ANDROID_HOME/emulator/emulator -avd ${AVD:-pixel7} >/dev/null 2>&1 & until $ANDROID_HOME/platform-tools/adb shell getprop sys.boot_completed 2>/dev/null | grep -q 1; do sleep 2; done",
    "emu:kill": "$ANDROID_HOME/platform-tools/adb emu kill",
    "sync:live": "CAP_SERVER_URL=http://10.0.2.2:5173 cap sync android",
    "android:install": "cd android && ./gradlew installDebug",
    "android:console": "node scripts/cdp-console.mjs",
    "android:state": "node scripts/cdp-console.mjs --state --once"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/barcode-scanner": "3.1.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "8.0.1",
    "antd-mobile": "^5.42.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "8.1.5",
    "vitest": "^4.1.11"
  }
}
